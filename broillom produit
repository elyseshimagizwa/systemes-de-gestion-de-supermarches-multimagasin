function clean(?string $value): string
{
    return trim((string)$value);
}

function stockBadge(int $quantite, int $seuil): array
{
    if ($quantite <= 0) {

        return [
            'class' => 'bg-red-100 text-red-700',
            'text'  => 'Rupture'
        ];
    }

    if ($quantite <= $seuil) {

        return [
            'class' => 'bg-yellow-100 text-yellow-700',
            'text'  => 'Faible'
        ];
    }

    return [
        'class' => 'bg-green-100 text-green-700',
        'text'  => 'Disponible'
    ];
}

function ajouterHistorique(
    PDO $pdo,
    string $action,
    string $details,
    string $niveau = 'info'
): void {

    $stmt = $pdo->prepare("
        INSERT INTO historiques
        (
            utilisateur_id,
            magasin_id,
            action,
            details,
            ip,
            created_at,
            niveau
        )
        VALUES
        (
            :utilisateur_id,
            :magasin_id,
            :action,
            :details,
            :ip,
            NOW(),
            :niveau
        )
    ");

    $stmt->execute([

        ':utilisateur_id' => currentUser()['id'] ?? null,

        ':magasin_id' => currentUser()['magasin_id'] ?? null,

        ':action' => $action,

        ':details' => $details,

        ':ip' => $_SERVER['REMOTE_ADDR'] ?? 'IP inconnue',

        ':niveau' => $niveau
    ]);
}

function enregistrerMouvementStock(
    PDO $pdo,
    int $magasin_id,
    int $produit_id,
    string $type,
    int $quantite,
    int $ancien,
    int $nouveau,
    string $motif
): void {

    $stmt = $pdo->prepare("
        INSERT INTO stock_mouvements
        (
            magasin_id,
            produit_id,
            type,
            quantite,
            ancien_stock,
            nouveau_stock,
            motif,
            utilisateur_id,
            date_mouvement
        )
        VALUES
        (
            :magasin_id,
            :produit_id,
            :type,
            :quantite,
            :ancien_stock,
            :nouveau_stock,
            :motif,
            :utilisateur_id,
            NOW()
        )
    ");

    $stmt->execute([

        ':magasin_id' => $magasin_id,

        ':produit_id' => $produit_id,

        ':type' => $type,

        ':quantite' => $quantite,

        ':ancien_stock' => $ancien,

        ':nouveau_stock' => $nouveau,

        ':motif' => $motif,

        ':utilisateur_id' => currentUser()['id']
    ]);
}

/* =========================================================
   AJOUT PRODUIT
========================================================= */

if (
    $_SERVER['REQUEST_METHOD'] === 'POST' &&
    isset($_POST['ajouter'])
) {

    verify_csrf();

    $nom = clean($_POST['nom'] ?? '');
    $codebarre = clean($_POST['codebarre'] ?? '');

    $prix_achat = (float)($_POST['prix_achat'] ?? 0);
    $prix_vente = (float)($_POST['prix_vente'] ?? 0);

    $quantite = max(0, (int)($_POST['quantite'] ?? 0));

    $seuil_alerte = max(0, (int)($_POST['seuil_alerte'] ?? 1));

    $date_peremption =
        !empty($_POST['date_peremption'])
        ? $_POST['date_peremption']
        : null;

    $fournisseur_id =
        !empty($_POST['fournisseur_id'])
        ? (int)$_POST['fournisseur_id']
        : null;

    $categorie_id =
        !empty($_POST['categorie_id'])
        ? (int)$_POST['categorie_id']
        : null;

    if (
        empty($nom) ||
        $prix_achat < 0 ||
        $prix_vente < 0
    ) {

        flash('error', 'Données invalides');

        header('Location: produits.php');

        exit;
    }

    $check = $pdo->prepare("
        SELECT id
        FROM produits
        WHERE codebarre = ?
        AND magasin_id = ?
        LIMIT 1
    ");

    $check->execute([
        $codebarre,
        $magasin_id
    ]);

    if ($codebarre !== '' && $check->fetch()) {

        flash('error', 'Code barre déjà utilisé');

        header('Location: produits.php');

        exit;
    }

    try {

        $pdo->beginTransaction();

        $stmt = $pdo->prepare("
            INSERT INTO produits
            (
                magasin_id,
                nom,
                codebarre,
                prix_achat,
                prix_vente,
                quantite,
                seuil_alerte,
                date_peremption,
                fournisseur_id,
                categorie_id,
                created_at
            )
            VALUES
            (
                :magasin_id,
                :nom,
                :codebarre,
                :prix_achat,
                :prix_vente,
                :quantite,
                :seuil_alerte,
                :date_peremption,
                :fournisseur_id,
                :categorie_id,
                NOW()
            )
        ");

        $stmt->execute([

            ':magasin_id' => $magasin_id,

            ':nom' => $nom,

            ':codebarre' => $codebarre,

            ':prix_achat' => $prix_achat,

            ':prix_vente' => $prix_vente,

            ':quantite' => $quantite,

            ':seuil_alerte' => $seuil_alerte,

            ':date_peremption' => $date_peremption,

            ':fournisseur_id' => $fournisseur_id,

            ':categorie_id' => $categorie_id
        ]);

        $produit_id = (int)$pdo->lastInsertId();

        ajouterHistorique(
            $pdo,
            'AJOUT PRODUIT',
            'Ajout produit : ' . $nom,
            'success'
        );

        enregistrerMouvementStock(
            $pdo,
            $magasin_id,
            $produit_id,
            'entree',
            $quantite,
            0,
            $quantite,
            'Ajout nouveau produit'
        );

        $pdo->commit();

        flash('success', '✅ Produit ajouté');

    } catch (Throwable $e) {

        $pdo->rollBack();

        flash('error', 'Erreur lors de l’ajout');
    }

    header('Location: produits.php');

    exit;
}

/* =========================================================
   MODIFICATION PRODUIT
========================================================= */

if (
    $_SERVER['REQUEST_METHOD'] === 'POST' &&
    isset($_POST['update'])
) {

    verify_csrf();

    $id = (int)($_POST['id'] ?? 0);

    $stmt = $pdo->prepare("
        SELECT *
        FROM produits
        WHERE id = ?
        AND magasin_id = ?
        LIMIT 1
    ");

    $stmt->execute([
        $id,
        $magasin_id
    ]);

    $ancienProduit = $stmt->fetch();

    if (!$ancienProduit) {

        flash('error', 'Produit introuvable');

        header('Location: produits.php');

        exit;
    }

    $nom = clean($_POST['nom'] ?? '');
    $codebarre = clean($_POST['codebarre'] ?? '');

    $prix_achat = (float)($_POST['prix_achat'] ?? 0);
    $prix_vente = (float)($_POST['prix_vente'] ?? 0);

    $quantite = max(0, (int)($_POST['quantite'] ?? 0));

    $seuil_alerte = max(0, (int)($_POST['seuil_alerte'] ?? 1));

    $date_peremption =
        !empty($_POST['date_peremption'])
        ? $_POST['date_peremption']
        : null;

    $fournisseur_id =
        !empty($_POST['fournisseur_id'])
        ? (int)$_POST['fournisseur_id']
        : null;

    $categorie_id =
        !empty($_POST['categorie_id'])
        ? (int)$_POST['categorie_id']
        : null;

    $check = $pdo->prepare("
        SELECT id
        FROM produits
        WHERE codebarre = ?
        AND magasin_id = ?
        AND id != ?
        LIMIT 1
    ");

    $check->execute([
        $codebarre,
        $magasin_id,
        $id
    ]);

    if ($codebarre !== '' && $check->fetch()) {

        flash('error', 'Code barre déjà utilisé');

        header('Location: produits.php');

        exit;
    }

    try {

        $pdo->beginTransaction();

        $update = $pdo->prepare("
            UPDATE produits
            SET
                nom = :nom,
                codebarre = :codebarre,
                prix_achat = :prix_achat,
                prix_vente = :prix_vente,
                quantite = :quantite,
                seuil_alerte = :seuil_alerte,
                date_peremption = :date_peremption,
                fournisseur_id = :fournisseur_id,
                categorie_id = :categorie_id
            WHERE id = :id
            AND magasin_id = :magasin_id
        ");

        $update->execute([

            ':nom' => $nom,

            ':codebarre' => $codebarre,

            ':prix_achat' => $prix_achat,

            ':prix_vente' => $prix_vente,

            ':quantite' => $quantite,

            ':seuil_alerte' => $seuil_alerte,

            ':date_peremption' => $date_peremption,

            ':fournisseur_id' => $fournisseur_id,

            ':categorie_id' => $categorie_id,

            ':id' => $id,

            ':magasin_id' => $magasin_id
        ]);

        ajouterHistorique(
            $pdo,
            'MODIFICATION PRODUIT',
            'Produit : ' . $nom,
            'warning'
        );

        enregistrerMouvementStock(
            $pdo,
            $magasin_id,
            $id,
            'modification',
            $quantite,
            (int)$ancienProduit['quantite'],
            $quantite,
            'Modification produit'
        );

        $pdo->commit();

        flash('success', '✅ Produit modifié');

    } catch (Throwable $e) {

        $pdo->rollBack();

        flash('error', 'Erreur modification');
    }

    header('Location: produits.php');

    exit;
}

/* =========================================================
   MOUVEMENT STOCK
========================================================= */

if (
    $_SERVER['REQUEST_METHOD'] === 'POST' &&
    isset($_POST['stock_action'])
) {

    verify_csrf();

    $produit_id = (int)($_POST['produit_id'] ?? 0);

    $quantite_action = max(
        1,
        (int)($_POST['quantite_action'] ?? 1)
    );

    $stock_action = clean($_POST['stock_action'] ?? '');

    $stmt = $pdo->prepare("
        SELECT *
        FROM produits
        WHERE id = ?
        AND magasin_id = ?
        LIMIT 1
    ");

    $stmt->execute([
        $produit_id,
        $magasin_id
    ]);

    $produit = $stmt->fetch();

    if (!$produit) {

        flash('error', 'Produit introuvable');

        header('Location: produits.php');

        exit;
    }

    $ancien_stock = (int)$produit['quantite'];

    if ($stock_action === 'entree') {

        $nouveau_stock =
            $ancien_stock + $quantite_action;

    } else {

        $nouveau_stock =
            max(
                0,
                $ancien_stock - $quantite_action
            );
    }

    try {

        $pdo->beginTransaction();

        $update = $pdo->prepare("
            UPDATE produits
            SET quantite = ?
            WHERE id = ?
            AND magasin_id = ?
        ");

        $update->execute([
            $nouveau_stock,
            $produit_id,
            $magasin_id
        ]);

        enregistrerMouvementStock(
            $pdo,
            $magasin_id,
            $produit_id,
            $stock_action,
            $quantite_action,
            $ancien_stock,
            $nouveau_stock,
            ucfirst($stock_action) . ' stock'
        );

        ajouterHistorique(
            $pdo,
            strtoupper($stock_action) . ' STOCK',
            'Produit : ' . $produit['nom'],
            'info'
        );

        $pdo->commit();

        flash('success', '✅ Stock mis à jour');

    } catch (Throwable $e) {

        $pdo->rollBack();

        flash('error', 'Erreur mise à jour stock');
    }

    header('Location: produits.php');

    exit;
}

/* =========================================================
