    $produit = $stmt->fetch();

    if (!$produit) {

        flash('error', 'Produit introuvable');

        header('Location: produits.php');

        exit;
    }

    try {

        $pdo->beginTransaction();

        ajouterHistorique(
            $pdo,
            'SUPPRESSION PRODUIT',
            'Produit supprimé : ' . $produit['nom'],
            'danger'
        );

        enregistrerMouvementStock(
            $pdo,
            $magasin_id,
            $id,
            'suppression',
            (int)$produit['quantite'],
            (int)$produit['quantite'],
            0,
            'Suppression produit'
        );

        $delete = $pdo->prepare("
            DELETE FROM produits
            WHERE id = ?
            AND magasin_id = ?
        ");

        $delete->execute([
            $id,
            $magasin_id
        ]);

        $pdo->commit();

        flash('success', '🗑 Produit supprimé');

    } catch (Throwable $e) {

        $pdo->rollBack();

        flash('error', 'Erreur suppression');
    }

    header('Location: produits.php');

    exit;
}

